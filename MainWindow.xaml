<Window x:Class="WinMorph.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinMorph" Width="1280" Height="830" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Table}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" FontFamily="{StaticResource Body}">
    <Grid x:Name="Root" Background="{StaticResource Table}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ head: wordmark, job folder tabs, update, language ============ -->
        <Grid Margin="30,0,30,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <Grid x:Name="Mark" Width="34" Height="34" Margin="0,0,10,14" VerticalAlignment="Bottom"/>
                <TextBlock Text="WinMorph" FontFamily="{StaticResource Display}" FontWeight="ExtraBold" FontSize="27" Margin="0,0,34,14" VerticalAlignment="Bottom"/>
                <RadioButton x:Name="TabLooks" Style="{StaticResource Tab}" GroupName="page" IsChecked="True" Checked="Tab_Checked">
                    <TextBlock x:Name="TLooks" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontWeight="Bold" FontSize="15"/>
                </RadioButton>
                <RadioButton x:Name="TabChanges" Style="{StaticResource Tab}" GroupName="page" Margin="4,0,0,0" Checked="Tab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TChanges" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        <Border x:Name="ChangeBadge" Background="{StaticResource Magenta}" CornerRadius="9" MinWidth="20" Height="20" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                            <TextBlock x:Name="ChangeCount" Foreground="White" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="UpdBtn" Style="{StaticResource Outline}" Height="36" Margin="0,0,14,0" Visibility="Collapsed" Click="Update_Click">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Go}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TUpd" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Border Background="#DDE0E6" CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LangDe" Content="DE" Click="LangDe_Click" Style="{StaticResource Outline}" Height="28" FontSize="12.5" Padding="12,0" BorderThickness="0"/>
                        <Button x:Name="LangEn" Content="EN" Click="LangEn_Click" Style="{StaticResource Outline}" Height="28" FontSize="12.5" Padding="12,0" BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ============ pages: they sit on the open folder (white) ============ -->
        <Border Grid.Row="1" Background="{StaticResource Paper}" CornerRadius="0">
            <Grid>
                <Grid x:Name="LooksPage" Margin="30,24,30,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition x:Name="TicketCol" Width="390"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="128"/>
                        </Grid.RowDefinitions>
                        <!-- the print table with the proof sheet -->
                        <Border x:Name="PrintTable" Background="{StaticResource Table}" CornerRadius="14">
                            <Grid x:Name="SheetHost"/>
                        </Border>
                        <UniformGrid x:Name="ScreenRow" Grid.Row="2" Rows="1" Columns="3"/>
                    </Grid>
                    <Grid x:Name="TicketHost" Grid.Column="2"/>
                </Grid>
                <Grid x:Name="ChangesPage" Margin="30,24,30,26" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- dialogs -->
        <Grid x:Name="Overlay" Grid.RowSpan="2" Visibility="Collapsed"/>
    </Grid>
</Window>

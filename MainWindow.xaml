<Window x:Class="WinMorph.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinMorph" Width="1260" Height="820" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Floor}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" FontFamily="{StaticResource Body}">
    <Grid x:Name="Root" Background="{StaticResource Floor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ top bar ============ -->
        <Border x:Name="TopBar" Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="Logo" Width="30" Height="30" VerticalAlignment="Center"/>
                    <TextBlock Text="WINMORPH" FontFamily="{StaticResource Display}" FontWeight="ExtraBold" FontSize="29" Margin="10,0,40,0" VerticalAlignment="Center"/>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabLooks" Style="{StaticResource Tab}" GroupName="page" IsChecked="True" Checked="Tab_Checked">
                                <TextBlock x:Name="TLooks" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontWeight="SemiBold" FontSize="15"/>
                            </RadioButton>
                            <RadioButton x:Name="TabChanges" Style="{StaticResource Tab}" GroupName="page" Margin="30,0,0,0" Checked="Tab_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TChanges" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                                    <Border x:Name="ChangeBadge" Background="{StaticResource Samt}" CornerRadius="9" MinWidth="20" Height="20" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                        <TextBlock x:Name="ChangeCount" Foreground="White" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <Border x:Name="TabLine" Height="3" Width="40" Background="{StaticResource Samt}" CornerRadius="2" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="UpdBtn" Style="{StaticResource Outline}" Height="36" Margin="0,0,18,0" Visibility="Collapsed" Click="Update_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Go}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TUpd" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Border Background="{StaticResource Floor}" CornerRadius="9" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LangDe" Content="DE" Click="LangDe_Click" Style="{StaticResource Outline}" Height="28" FontSize="12.5" Padding="12,0" BorderThickness="0"/>
                            <Button x:Name="LangEn" Content="EN" Click="LangEn_Click" Style="{StaticResource Outline}" Height="28" FontSize="12.5" Padding="12,0" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ pages ============ -->
        <Grid Grid.Row="1">
            <Grid x:Name="LooksPage" Margin="28,24,28,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition x:Name="DetailCol" Width="400"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="124"/>
                    </Grid.RowDefinitions>
                    <!-- the stage: a dark proscenium, the look behind a velvet curtain -->
                    <Border x:Name="Stage" Background="{StaticResource Ink}" CornerRadius="20" Padding="12">
                        <Grid x:Name="StageInner"/>
                    </Border>
                    <UniformGrid x:Name="TileRow" Grid.Row="2" Rows="1" Columns="3"/>
                </Grid>
                <Border x:Name="DetailCard" Grid.Column="2" Background="{StaticResource Paper}" CornerRadius="20" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <Grid x:Name="DetailHost"/>
                </Border>
            </Grid>
            <Grid x:Name="ChangesPage" Margin="28,24,28,26" Visibility="Collapsed"/>
        </Grid>

        <!-- dialogs -->
        <Grid x:Name="Overlay" Grid.RowSpan="2" Visibility="Collapsed"/>
    </Grid>
</Window>

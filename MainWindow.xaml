<Window x:Class="WinMorph.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinMorph" Width="1320" Height="840" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root" Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="392"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,22,16,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                    <Image x:Name="Logo" Width="34" Height="34"/>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WinMorph" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TSubtitle" FontSize="11.5" Foreground="{StaticResource Faint}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border x:Name="UpdateCard" Visibility="Collapsed" CornerRadius="12" Padding="14,13,14,14" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#3B3F72">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#252A4D" Offset="0"/>
                                <GradientStop Color="#1D1733" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#8FA0FF" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                <TextBlock x:Name="UpdTitle" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="UpdText" FontSize="11.5" Foreground="{StaticResource Sub}" TextWrapping="Wrap" LineHeight="16" Margin="0,4,0,11"/>
                            <Button x:Name="UpdBtn" Style="{StaticResource Small}" Click="Update_Click">
                                <TextBlock x:Name="TUpdBtn" Foreground="White" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button x:Name="UndoBtn" Style="{StaticResource Ghost}" Click="Undo_Click" Margin="0,0,0,8">
                        <TextBlock x:Name="TUndo" Foreground="{StaticResource Text}"/>
                    </Button>
                    <Button x:Name="RestoreBtn" Style="{StaticResource Ghost}" Click="Restore_Click">
                        <TextBlock x:Name="TRestore" Foreground="{StaticResource Text}"/>
                    </Button>
                    <TextBlock x:Name="BackupInfo" FontSize="11.5" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="4,8,0,16"/>
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                        <Button x:Name="LangDe" Style="{StaticResource Ghost}" Content="Deutsch" Click="LangDe_Click" Margin="0,0,6,0"/>
                        <Button x:Name="LangEn" Style="{StaticResource Ghost}" Content="English" Click="LangEn_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="OptAutoUpdate" Style="{StaticResource Switch}" Tag="{StaticResource Accent}" Margin="4,16,0,0" Click="AutoUpdate_Click">
                        <TextBlock x:Name="TAutoUpdate" FontSize="12" Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                    </CheckBox>
                    <TextBlock x:Name="VersionLink" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="4,12,0,0" Cursor="Hand" MouseLeftButtonUp="Website_Click" ToolTip="winmorph.benjaminberger.at">
                        <Run x:Name="TVersion"/><Run Text="  ·  "/><Run Text="Website ↗" Foreground="{StaticResource Sub}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel x:Name="NavPanel"/>
            </DockPanel>
        </Border>

        <!-- ============ Gallery ============ -->
        <Grid Grid.Column="1">
            <Grid.Background>
                <RadialGradientBrush Center="0.15,0" GradientOrigin="0.15,0" RadiusX="0.9" RadiusY="0.55">
                    <GradientStop Color="#1A1D2E" Offset="0"/>
                    <GradientStop Color="#0C0E12" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <ScrollViewer x:Name="GalleryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,26,14,10">
                <StackPanel>
                    <TextBlock x:Name="THead" FontSize="30" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                    <TextBlock x:Name="THeadSub" FontSize="13.5" Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,6,24,22" MaxWidth="720" HorizontalAlignment="Left"/>
                    <WrapPanel x:Name="Cards" SizeChanged="Cards_SizeChanged"/>
                    <StackPanel x:Name="ExtrasPanel" Visibility="Collapsed" Margin="0,0,24,0"/>
                    <TextBlock x:Name="TFooter" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="0,8,0,10"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ Detail ============ -->
        <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,16,22,18">
                    <StackPanel>
                        <Button x:Name="ApplyBtn" Style="{StaticResource Primary}" Click="Apply_Click">
                            <TextBlock x:Name="TApply" Foreground="White" FontWeight="SemiBold"/>
                        </Button>
                        <TextBlock x:Name="Status" FontSize="12" Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="2,10,0,0"/>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,22,22,18">
                        <Border x:Name="PreviewFrame" Height="196" SizeChanged="PreviewFrame_SizeChanged">
                            <Image x:Name="BigPreview" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock x:Name="DName" FontSize="24" FontWeight="SemiBold" Margin="0,18,0,0"/>
                        <TextBlock x:Name="DTag" FontSize="13" Margin="0,2,0,0"/>
                        <TextBlock x:Name="DDesc" FontSize="13" Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="19"/>
                        <StackPanel x:Name="ColorBox" Visibility="Collapsed"/>

                        <TextBlock x:Name="TChanges" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Faint}" Margin="0,20,0,10"/>
                        <StackPanel x:Name="AreaList"/>

                        <TextBlock x:Name="TOptions" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Faint}" Margin="0,20,0,10"/>
                        <CheckBox x:Name="OptExplorer" Style="{StaticResource Switch}" IsChecked="True" Margin="0,0,0,10"><TextBlock x:Name="TOptExplorer" FontSize="12.5" TextWrapping="Wrap"/></CheckBox>
                        <CheckBox x:Name="OptLock" Style="{StaticResource Switch}" IsChecked="False" Margin="0,0,0,4"><TextBlock x:Name="TOptLock" FontSize="12.5" TextWrapping="Wrap"/></CheckBox>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
